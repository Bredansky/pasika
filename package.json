{
  "name": "pasika",
  "version": "0.3.2",
  "description": "Reusable agent setup package",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bredansky/pasika"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint/pasika/index.d.ts",
      "import": "./dist/eslint/pasika/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pasika": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "enforcement/registry.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "coverage": "tsx cli/index.ts coverage",
    "docs": "eslint docs",
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "node --import tsx --test 'eslint/**/*.test.ts' 'enforcement/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/css-tree": "^4.0.5",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@humanwhocodes/momoa": "^3.3.12",
    "@types/estree": "^1.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/utils": "^8.68.0",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "zirka": "^0.0.42"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
