{
  "name": "pasika",
  "version": "0.7.4",
  "description": "Reusable agent setup package",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bredansky/pasika"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint/pasika/index.d.ts",
      "import": "./dist/eslint/pasika/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "coverage": "tsx scripts/coverage.ts",
    "dogfood": "tsx scripts/dogfood.ts",
    "fix": "eslint . --fix",
    "format": "prettier --check . --ignore-unknown",
    "format:staged": "prettier --write --ignore-unknown",
    "lint": "eslint .",
    "lint:staged": "eslint --fix",
    "prepack": "npm run build",
    "prepare": "husky",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:staged": "vitest related --run",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "!(*.ts|*.mts|*.cts|*.tsx|*.js|*.cjs|*.mjs|*.jsx)": "npm run format:staged --",
    "*.ts|*.mts|*.cts|*.tsx|*.js|*.cjs|*.mjs|*.jsx": [
      "npm run lint:staged --",
      "npm run test:unit:staged --"
    ]
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.68.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/css": "1.4.0",
    "@eslint/css-tree": "4.0.5",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@humanwhocodes/momoa": "3.3.12",
    "@types/estree": "1.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.8.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "zirka": "0.0.65",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@eslint/css": ">=1.4.0",
    "@eslint/json": ">=2.0.1",
    "@eslint/markdown": ">=8.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
